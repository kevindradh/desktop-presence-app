# Copy to %LOCALAPPDATA%\StarGate\.env and set BOTH private passwords locally.
STARGATE_DB_HOST=127.0.0.1
STARGATE_DB_PORT=5432
STARGATE_DB_NAME=stargate_local
STARGATE_DB_USER=stargate_app
STARGATE_DB_PASSWORD=REPLACE_WITH_PRIVATE_APP_PASSWORD
STARGATE_DB_MIGRATION_USER=stargate_migrator
STARGATE_DB_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_PRIVATE_OWNER_PASSWORD
STARGATE_TIMEZONE=Asia/Jakarta
STARGATE_LOG_LEVEL=INFO
# MODEL_DIR intentionally omitted: use verified read-only models in the bundle.
# External models: STARGATE_MODEL_DIR=C:\Users\you\AppData\Local\StarGate\models
