# Copy to .env only if not using scripts/provision_local_db.py.
# The provisioner creates random credentials locally and refuses to overwrite .env.
STARGATE_DB_HOST=127.0.0.1
STARGATE_DB_PORT=55432
STARGATE_DB_NAME=stargate_dev
STARGATE_DB_TEST_NAME=stargate_test
STARGATE_DB_USER=stargate_app
STARGATE_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
STARGATE_DB_MIGRATION_USER=stargate_migrator
STARGATE_DB_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
STARGATE_TIMEZONE=Asia/Jakarta
STARGATE_MODEL_DIR=resources/models
STARGATE_LOG_DIR=logs
STARGATE_LOG_LEVEL=INFO
STARGATE_SIMILARITY_THRESHOLD=0.60
STARGATE_LIVENESS_ENABLED=true
STARGATE_LIVENESS_THRESHOLD=0.85
STARGATE_RECOGNITION_TIMEOUT=3
STARGATE_DUPLICATE_WINDOW=60
# Local provisioner socket is .local/pgsocket on macOS; not used on Windows.

# Camera capture: explicit user start; latest frame only, no frame files.
STARGATE_CAMERA_MAX_STREAMS=2
STARGATE_CAMERA_OPEN_TIMEOUT=5
STARGATE_CAMERA_READ_TIMEOUT=3
# RTSP only; local webcams require manual restart after failure.
STARGATE_CAMERA_RECONNECT_ATTEMPTS=2
